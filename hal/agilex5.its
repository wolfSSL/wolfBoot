/dts-v1/;

/ {
    description = "Altera Agilex 5 wolfBoot Linux payload";
    #address-cells = <1>;

    images {
        kernel-1 {
            description = "Linux kernel";
            data = /incbin/("../Image");
            type = "kernel";
            arch = "arm64";
            os = "linux";
            compression = "none";
            load = <0x82000000>;
            entry = <0x82000000>;
            hash-1 { algo = "sha256"; };
        };
        fdt-1 {
            description = "Agilex 5 device tree";
            data = /incbin/("../socfpga_agilex5_socdk.dtb");
            type = "flat_dt";
            arch = "arm64";
            compression = "none";
            load = <0x8f000000>;
            hash-1 { algo = "sha256"; };
        };
    };

    configurations {
        default = "conf-1";
        conf-1 {
            description = "Agilex 5 Linux";
            kernel = "kernel-1";
            fdt = "fdt-1";
            hash-1 { algo = "sha256"; };
        };
    };
};
