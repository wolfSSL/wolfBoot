/* VEK385 boot image: AMD's base design PDI, then the board DTB, TF-A
 * BL31 (EL3) and wolfBoot (EL2). See docs/Targets.md, "Board (JTAG)". */
the_ROM_image:
{
	image {
		{ type=bootimage, file=base-design.pdi }
	}
	image {
		id = 0x1c000000, name=apu_subsystem
		{ type=raw, load=0x1000000, file=system.dtb }
		{ core=a78-0, exception_level=el-3, trustzone, file=bl31.elf }
		{ core=a78-0, exception_level=el-2, file=wolfboot.elf }
	}
}
