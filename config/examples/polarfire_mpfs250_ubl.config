# PolarFire SoC MPFS250 boot mode 2 User Boot Loader (UBL) stub
#
# A first-stage verifier for the "user secure boot from sNVM" boot mode:
#   1. The System Controller authenticates (and optionally decrypts) the
#      stub out of sNVM, copies it to the LIM (0x08000000) and releases
#      all five harts at its entry point.
#   2. The E51 verifies the wolfBoot manifest in eNVM (ECC384 signature,
#      SHA384 digest) against the public key compiled into the stub.
#   3. All five harts enter the eNVM wolfBoot at its reset vector, exactly
#      as a boot mode 1 boot would; wolfBoot then boots the system from
#      there (see polarfire_mpfs250_m.config).
#
# The eNVM wolfBoot is built with MPFS_ENVM_MANIFEST=1 and signed with
# `make wolfboot_envm_signed.bin`: the image stays at 0x20220100 and its
# manifest goes in eNVM page 0x1FC (0x2023FC00); see docs/Targets.md.
#
# Program sNVM + boot mode (requires SoftConsole / Libero SoC):
#   java -jar mpfsBootmodeProgrammer.jar --bootmode 2 --snvm_page 0 \
#        --usk 0 --die MPFS250T --package FCG1152 --workdir $PWD wolfboot.elf

ARCH?=RISCV64
TARGET?=mpfs250_ubl
SIGN?=ECC384
HASH?=SHA384
IMAGE_HEADER_SIZE=512
WOLFBOOT_VERSION?=1
ARMORED?=0
DEBUG?=0
DEBUG_SYMBOLS?=1
DEBUG_UART?=1
VTOR?=1
EXT_FLASH?=0
SPI_FLASH?=0
NO_XIP?=1
NVM_FLASH_WRITEONCE?=0
UART_FLASH?=0
V?=0
NO_MPU?=1
RAM_CODE?=0
SPMATH?=1
SPMATHALL?=0
DUALBANK_SWAP?=0
PKA?=0
ENCRYPT=0
WOLFTPM?=0
ELF?=0

# Size first: the stub must fit the authenticated sNVM pages (see
# hal/mpfs250_ubl.ld).  Portable C crypto; the E51 is rv64imac.
OPTIMIZATION_LEVEL=s
NO_ASM?=1

# Runs on the E51 in M-mode at the reset clock, no HSS.
RISCV_MMODE?=1

# No update path: the stub verifies one manifest in place and jumps.
NO_LOADER=1
WOLFBOOT_NO_PARTITIONS=1

# LIM placement.  The System Controller copies the image to the address in
# the UBL header, which the programmer takes from the ELF.
WOLFBOOT_ORIGIN?=0x08000000
BOOTLOADER_PARTITION_SIZE?=0x40000
STACK_SIZE?=32k

# The manifest header is detached from the image it signs: a page near the
# end of eNVM, image from the reset vector (hal/mpfs250.h).
WOLFBOOT_SELF_HEADER=1
WOLFBOOT_PARTITION_SELF_HEADER_ADDRESS=0x2023FC00
WOLFBOOT_SECTOR_SIZE?=0x200

# Informational: where the verified eNVM wolfBoot lives.
WOLFBOOT_PARTITION_BOOT_ADDRESS=0x20220100
WOLFBOOT_PARTITION_SIZE=0x1FD00

# Refuse a manifest older than this version (0 = any).
#CFLAGS_EXTRA+=-DMPFS_UBL_MIN_VERSION=1
