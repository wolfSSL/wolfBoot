ARCH?=ARM
TARGET?=psoc6
PSOC6_BOARD?=CY8CKIT_062S2_43012
SIGN?=ECC256
HASH?=SHA256
CYPRESS_PDL?=$(WOLFBOOT_ROOT)/lib/mtb-pdl-cat1
CYPRESS_CMSIS?=$(WOLFBOOT_ROOT)/lib/cmsis
CYPRESS_TEMPLATE_LIB?=$(WOLFBOOT_ROOT)/lib/mtb-template-cat1
CYPRESS_CORE_LIB?=$(WOLFBOOT_ROOT)/lib/core-lib
DEBUG?=0
DEBUG_UART?=1
VTOR?=1
NO_MPU?=1
FLAGS_INVERT?=1
CORTEX_M0?=1
NO_ASM?=0
EXT_FLASH?=1
NO_SWAP_EXT?=1
FLAGS_HOME?=1
SPI_FLASH?=0
NO_XIP?=0
UART_FLASH?=0
ALLOW_DOWNGRADE?=0
NVM_FLASH_WRITEONCE?=1
WOLFBOOT_VERSION?=0
V?=0
SPMATH?=1
RAM_CODE?=0
DUALBANK_SWAP?=0
PKA?=0
WOLFTPM?=0
PSOC6_CRYPTO?=0
# Sectors match the 256 KB QSPI erase sector. wolfBoot 0x10000000 (256 KB),
# BOOT 0x10040000 (1.5 MB) and SWAP 0x101C0000 (256 KB) in internal flash,
# UPDATE 0x18000000 (1.5 MB) in QSPI. QSPI erases to 0xFF, so FLAGS_HOME
# keeps every flag in the BOOT trailer.
WOLFBOOT_PARTITION_SIZE?=0x180000
WOLFBOOT_SECTOR_SIZE?=0x40000
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0x10040000
WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0x18000000
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0x101C0000
