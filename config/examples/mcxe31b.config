# wolfBoot configuration for NXP MCX E31B (FRDM-MCXE31B)
#
# MCXE31B: Cortex-M7, 4 MB code flash (four 1 MB blocks) + 128 KB data flash,
# 8 KB sectors. wolfBoot switches the core from FIRC 48 MHz to the PLL
# (160 MHz) and enables the caches. It runs from flash, with data, bss and the
# RAM_CODE flash routines in the 64 KB CM7_0 DTCM.
#
# Build: cp config/examples/mcxe31b.config .config && make

ARCH?=ARM
TARGET?=mcxe31b
SIGN?=ECC256
HASH?=SHA256
VTOR?=1
NO_ASM?=0
NO_MPU=1
EXT_FLASH?=0
SPI_FLASH?=0
ALLOW_DOWNGRADE?=0

# Each 64-bit ECC segment of the flash can be programmed only once between
# erases
NVM_FLASH_WRITEONCE?=1

WOLFBOOT_VERSION?=0
V?=0
SPMATH?=1
RAM_CODE?=1
DUALBANK_SWAP?=0

# The CM7 DTCM is ECC protected and must be written before it is read
CFLAGS_EXTRA+=-DWOLFBOOT_RAM_ECC_INIT

# 8KB sectors
WOLFBOOT_SECTOR_SIZE?=0x2000

# Memory layout (code flash 0x00400000 - 0x007FFFFF):
#   IVT + Bootloader: 0x00400000 - 0x0040FFFF (64 KB)
#   Boot Partition:   0x00410000 - 0x005EFFFF (1920 KB)
#   Update Partition: 0x005F0000 - 0x007CFFFF (1920 KB)
#   Swap Sector:      0x007D0000 - 0x007D1FFF (8 KB)
# 0x007D4000 - 0x007FFFFF is left free: it holds the Secure BAF and, when the
# security firmware feature flag is set, the security firmware.
WOLFBOOT_PARTITION_SIZE?=0x1E0000
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0x410000
WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0x5F0000
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0x7D0000

# Console on the MCU-Link VCOM port: LPUART5, PTE14 (TX) and PTE3 (RX),
# 115200 8N1

# Debugging options
DEBUG?=0
DEBUG_SYMBOLS?=0
DEBUG_UART?=1
