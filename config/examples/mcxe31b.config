# wolfBoot configuration for NXP MCX E31B (FRDM-MCXE31B)
#
# MCXE31B: Cortex-M7, 4 MB code flash (four 1 MB blocks) + 128 KB data flash,
# 8 KB sectors. wolfBoot switches the core from FIRC 48 MHz to the PLL
# (160 MHz) and enables the caches. It runs from flash, with data, bss and the
# RAM_CODE flash routines in the 64 KB CM7_0 DTCM.
#
# Build: cp config/examples/mcxe31b.config .config && make

ARCH?=ARM
TARGET?=mcxe31b
SIGN?=ECC256
HASH?=SHA256
VTOR?=1
NO_ASM?=0
NO_MPU=1
EXT_FLASH?=0
SPI_FLASH?=0
ALLOW_DOWNGRADE?=0

# Each 64-bit ECC segment of the flash can be programmed only once between
# erases
NVM_FLASH_WRITEONCE?=1

WOLFBOOT_VERSION?=0
V?=0
SPMATH?=1
RAM_CODE?=1
DUALBANK_SWAP?=0

# The CM7 DTCM is ECC protected and must be written before it is read
CFLAGS_EXTRA+=-DWOLFBOOT_RAM_ECC_INIT

# 8KB sectors
WOLFBOOT_SECTOR_SIZE?=0x2000

# Word-at-a-time memcpy/memset in src/string.c (bootloader and test-app). The
# Cortex-M7 loads unaligned words, so memcpy copies words even when source and
# destination alignments differ.
CFLAGS_EXTRA+=-DFAST_MEMCPY

# The application's vector table follows the image header and is used in
# place (VTOR). The table must be 1 KB aligned, or the core fetches the vectors
# of some IRQs (e.g. EMAC, 105) from the wrong slots.
IMAGE_HEADER_SIZE?=1024

# Memory layout (code flash 0x00400000 - 0x007FFFFF):
#   IVT + Bootloader: 0x00400000 - 0x0040FFFF (64 KB)
#   Boot Partition:   0x00410000 - 0x005EFFFF (1920 KB)
#   Update Partition: 0x005F0000 - 0x007CFFFF (1920 KB)
#   Swap Sector:      0x007D0000 - 0x007D1FFF (8 KB)
# 0x007D4000 - 0x007FFFFF is left free: it holds the Secure BAF and, when the
# security firmware feature flag is set, the security firmware.
WOLFBOOT_PARTITION_SIZE?=0x1E0000
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0x410000
WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0x5F0000
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0x7D0000

# Console on the MCU-Link VCOM port: LPUART5, PTE14 (TX) and PTE3 (RX),
# 115200 8N1

# wolfIP network test in the test-app (optional)
# Adds the "network" console command. Needs a wolfIP checkout, which provides
# the nxp_mcxe_emac driver (EMAC, RMII to the LAN8741 PHY). The driver is
# interrupt driven; NXP_MCXE_EMAC_IRQ=0 makes it poll the EMAC instead.
ENABLE_WOLFIP?=0
WOLFBOOT_LIB_WOLFIP?=../lib/wolfip
NXP_MCXE_EMAC_IRQ?=1
# By default the command acquires a DHCP lease and runs a TCP and UDP
# throughput server on port 9, driven from the host by
# tools/scripts/wolfip_speed.py.
WOLFIP_SPEED_TEST?=1
# WOLFBOOT_TEST_TFTP=1 makes the command fetch a file over TFTP instead (it
# overrides WOLFIP_SPEED_TEST). The file must fit the 128 KB receive buffer.
# With both set to 0 the command only acquires a DHCP lease.
WOLFBOOT_TEST_TFTP?=0
CFLAGS_EXTRA+=-DHOST_IP_STR='"192.168.50.1"' -DTFTP_FILENAME='"wolfip_test.bin"'

# Debugging options
DEBUG?=0
DEBUG_SYMBOLS?=0
DEBUG_UART?=1
