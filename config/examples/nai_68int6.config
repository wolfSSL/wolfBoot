# NAI 68INT6 -- 3U OpenVPX SOSA SBC, Intel Core i7-118xGRE (Tiger Lake UP3).
# Memory is trained by the FSP from the board's own BIOS (the public TGL_IOT
# FSP does not train it), extracted with tools/scripts/x86_fsp/tgl/nai_extract_fsp.sh.
# See the NAI 68INT6 section of docs/Targets.md.

ARCH=x86_64
TARGET=nai_68int6
WOLFBOOT_SMALL_STACK=0

# ECC P-384 signature, SHA-384 digest (measured boot uses SHA-256 on an
# SLB9670). See the integrity-algorithm table in docs/Targets.md.
SIGN=ECC384
HASH=SHA384

DEBUG=1
# FSP-M UPD dump over the console before FspMemInit; bring-up aid, off by default.
DUMP_FSP_UPD=0
SPMATH=1
ENCRYPTION=0
WOLFBOOT_NO_PARTITIONS=1
# Disk boot: signed kernels in GPT partitions 3/4, Ubuntu root in partition 2.
# The A/B boot-partition indices are set per target in src/update_disk.c.
WOLFBOOT_BOOT_DISK=0
FORCE_32BIT=1

########## Flash layout (measured from the factory descriptor, 32 MB) ##########
WOLFBOOT_PARTITION_BOOT_ADDRESS=0xff400000
WOLFBOOT_PARTITION_SWAP_ADDRESS=0x0
WOLFBOOT_PARTITION_UPDATE_ADDRESS=0x0
WOLFBOOT_LOAD_BASE=0x58000200
WOLFBOOT_SECTOR_SIZE?=0x1000
WOLFBOOT_DATA_ADDRESS=0x1000000

FSP_CONFIG_BASE=0xffe9f800
FSP_T_BASE=0xfff59000
FSP_M_BASE=0xfff60000

WOLFBOOT_ORIGIN=0xfff00000
BOOTLOADER_PARTITION_SIZE=0x600000
# Inert (read from the flash descriptor, not this value); kept for config parity.
BIOS_REGION_SIZE=0xc00000

UCODE0_BASE=0xffd90000
UCODE0_BIN=src/x86/ucode0.bin

FSP_T_BIN=./src/x86/fsp_t.bin
FSP_M_BIN=./src/x86/fsp_m.bin
FSP_S_BIN=./src/x86/fsp_s.bin
FSP_S_UPD_DATA_BIN=./src/x86/fsp_s_upd_data.bin
# Boot Guard is left to the board owner: supply an ACM and key here to build a
# Boot-Guard image. Unset, wolfBoot builds and boots without it.
ACM_BIN=
FSP_S_LOAD_BASE=0x0FED5F00

POLICY_BASE=0xffaa4000
KEYSTORE_OFFSET=0x3FE00
KEYSTORE_STAGE1_OFFSET=0x400

########## Console: LPSS UART2 (PCI 00:19.2), verified on hardware ##########
X86_UART_NUMBER=2
X86_UART_BASE=0xFE032000
X86_UART_REG_WIDTH=4
X86_UART_MMIO=1

########## PCH / PCI ##########
PCH_PCR_BASE=0xFD000000
PCI_ECAM_BASE=0xC0000000
PCI_USE_ECAM=1
PCH_HAS_PCR=1
# Generate ACPI tables so Linux gets the interrupt model and PCI routing.
ACPI=1

########## Payload: signed 64-bit Linux bzImage ##########
64BIT=1
ELF=1
DEBUG_ELF=0
MULTIBOOT2=1
LINUX_PAYLOAD=1

########## Security ##########
STAGE1_AUTH=1
WOLFTPM=1
MEASURED_BOOT=1
MEASURED_PCR_A=0
# Measure the verified OS image into PCR4, alongside the firmware in PCR0.
MEASURED_PCR_OS=4
WOLFBOOT_UNIVERSAL_KEYSTORE=1
WOLFBOOT_SKIP_AUTH_CHECK=0
# BIOS region not write-locked by default; see "BIOS region lock" in docs/Targets.md.
WOLFBOOT_DONT_LOCK_BIOS=1
ENABLE_DEBUG_CONSENT=0

# Deferred: TPM sealing and ATA disk lock/erase.
WOLFBOOT_TPM_SEAL=0
DISK_LOCK=0
DISK_ERASE=0

# Anti-rollback: persistent version floor + audit counters in TPM NV
# (trust-on-first-use; provision before first boot where that matters).
ANTI_ROLLBACK=1
