# NXP S32G2 GoldBox (S32G-VNP-GLDBOX, S32G274A-RDB2) - wolfBoot as the Boot
# ROM's application image booting from the 64 MB QuadSPI NOR, with the A/B
# image partitions in the same NOR and the signed FIT loaded into DDR. No SD
# card is needed (DISK_SDCARD=0).
#
# NOR layout: wolfBoot at 0 (IVT, ROM QSPI parameters, code), BOOT partition
# at 1 MB, UPDATE at 17 MB, SWAP sector at 33 MB.
#   tools/scripts/s32g2/s32g2_mkimage.py wolfboot.bin s32g2_qspi_boot.bin --qspi
# The NOR is written by a programmer build of the SD config
# (S32G2_QSPI=1 S32G2_QSPI_PROGRAM_FILE=/<file>); the board must be strapped
# for QuadSPI boot.
# See docs/Targets.md.
#
# Never pass CFLAGS_EXTRA= on the command line - it replaces, not appends.
ARCH=AARCH64
TARGET=s32g2
S32G2_QSPI=1
SIGN?=ECC384
HASH?=SHA384
DEBUG?=1
DEBUG_UART?=1
SPMATH?=1
NO_XIP?=1
EXT_FLASH?=1
# The HAL sets up the GICv3 itself (hal/s32g2.c); skip the generic GICv2 init.
SKIP_GIC_INIT?=1
GZIP?=1
DISK_SDCARD?=0
# The MX25UW51245G keeps an ECC code for every 16 bytes and each of those
# units may be programmed once per erase, so the partition state cannot be
# rewritten in place: keep it as a log of 16-byte records. The log takes the
# last sector of each partition, and 64 KB sectors give it room for a 16 MB
# partition (the driver erases them as 4 KB flash sectors).
NVM_FLASH_JOURNAL?=1
WOLFBOOT_SECTOR_SIZE?=0x10000
WOLFBOOT_PARTITION_SIZE?=0x1000000
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0x100000
WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0x1100000
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0x2100000
# Separate DTB partitions are not used (the FIT carries the DTB) but the
# RAM-boot flow needs them defined; they sit after the swap sector.
WOLFBOOT_DTS_BOOT_ADDRESS?=0x2110000
WOLFBOOT_DTS_UPDATE_ADDRESS?=0x2120000

WOLFBOOT_RAMBOOT_MAX_SIZE=0x4000000
WOLFBOOT_LOAD_ADDRESS?=0xA0000000
WOLFBOOT_LOAD_DTS_ADDRESS?=0xA5000000
