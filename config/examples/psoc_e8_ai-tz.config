ARCH?=ARM
TARGET?=psoc_e8
SIGN?=ECC256
HASH?=SHA256
DEBUG?=0
VTOR?=1
CORTEX_M33?=1
TZEN?=1
NO_ASM?=0
NO_MPU=1
EXT_FLASH?=0
SPI_FLASH?=0
ALLOW_DOWNGRADE?=0
# The QSPI NOR rejects a second program into a 16-byte ECC unit.
NVM_FLASH_WRITEONCE?=1
WOLFBOOT_VERSION?=1
V?=0
SPMATH?=1
RAM_CODE?=1
DUALBANK_SWAP?=0
DEBUG_UART=1
# Keeps the application vector table 1 KB aligned.
IMAGE_HEADER_SIZE?=1024

# KIT_PSE84_AI with TrustZone: wolfBoot Secure, the application Non-secure.
# 64 MB QSPI NOR, 256 KB sectors. The boot partition is in the Non-secure
# code-bus alias, the rest in the Secure one. The application uses SRAM1
# (0x24080000) and prints through a Secure console gateway.
#
#   0x18100000 - 0x1813BFFF  wolfBoot slot: 0x400 boot header + wolfBoot
#   0x1813C000 - 0x1813FFFF  NSC gateway veneers
#   0x08140000 - 0x0823FFFF  BOOT              (1 MB, Non-secure)
#   0x18240000 - 0x1833FFFF  UPDATE            (1 MB)
#   0x18340000 - 0x1837FFFF  SWAP              (one sector)
#
# Board wiring: PSOC_E8_* make options in arch.mk, see docs/Targets.md.
WOLFBOOT_SECTOR_SIZE?=0x40000
WOLFBOOT_PARTITION_SIZE?=0x100000
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0x08140000
WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0x18240000
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0x18340000
WOLFBOOT_NSC_ADDRESS?=0x1813C000
WOLFBOOT_NSC_SIZE?=0x4000
