# STM32WBA55CG Nucleo, wolfBoot on the wolfHAL backend, ML-DSA-87 signatures.
#
# Flash: 1 MB at 0x08000000, 8 KB pages, 128-bit (16-byte) aligned writes.
# Non-secure / flat mode (the wolfHAL stm32wba flash driver uses the NS
# flash registers). ML-DSA-87 needs a 16 KB image header, so sectors grow
# to 16 KB (two pages) and the bootloader to 128 KB; two 432 KB partitions
# plus a 16 KB swap follow.
TARGET=stm32wba
BOARD=stm32wba55cg_nucleo
WOLFHAL=1
ARCH=ARM
SIGN=ML_DSA
ML_DSA_LEVEL=5
IMAGE_SIGNATURE_SIZE=4627
IMAGE_HEADER_SIZE=16384
HASH=SHA256
NO_MPU=1
SPMATH=1
WOLFBOOT_SECTOR_SIZE=0x4000
WOLFBOOT_PARTITION_SIZE=0x6C000
WOLFBOOT_PARTITION_BOOT_ADDRESS=0x08020000
WOLFBOOT_PARTITION_UPDATE_ADDRESS=0x0808C000
WOLFBOOT_PARTITION_SWAP_ADDRESS=0x080F8000
NVM_FLASH_WRITEONCE=1
