ARCH?=AURIX
TARGET?=aurix_tc3xx_hsm
SIGN?=RSAPSS4096
HASH?=SHA256
DEBUG?=0
WOLFBOOT_VERSION?=1
V?=0
SPMATH?=1
RAM_CODE?=1
SELF_UPDATE_MONOLITHIC=1
EXT_FLASH?=1
EXT_BOOT=1
EXT_UPDATE=1
EXT_SWAP=1
FLAGS_INVERT=1
FLASH_MULTI_SECTOR_ERASE=1
NVM_FLASH_JOURNAL=1
NVM_FLASH_ECC=1
DEBUG_UART=1
PRINTF_ENABLED=1
WOLFBOOT_IMG_HASH_ONESHOT=1

# wolfHSM options
WOLFHSM_SERVER=1

# Cert chain options
CERT_CHAIN_VERIFY=1

# RSA4096 cert chains need the larger header and stack
WOLFBOOT_HUGE_STACK=1
IMAGE_HEADER_SIZE=4096

# self-header feature (persist header in external flash)
WOLFBOOT_SELF_HEADER=1
SELF_HEADER_EXT=1

# Asymmetric monolithic layout. BOOT (0x28000) only holds the app, and UPDATE
# (0x3C000) stages the monolithic payload. UPDATE is the install span
# (bootloader region 0x10000 + BOOT 0x28000) plus one sector for the image
# header, so the app can use all of BOOT except its trailer sectors. See
# "Independent partition sizing" in docs/firmware_update.md.
# No SWAP partition in monolithic mode, so 0 marks it not present.
ARCH_FLASH_OFFSET=0x80028000
WOLFBOOT_SECTOR_SIZE=0x4000
WOLFBOOT_PARTITION_SIZE=0x28000
WOLFBOOT_PARTITION_UPDATE_SIZE=0x3C000
WOLFBOOT_PARTITION_BOOT_ADDRESS=0x80038000
WOLFBOOT_PARTITION_UPDATE_ADDRESS=0x80060000
WOLFBOOT_PARTITION_SWAP_ADDRESS=0
WOLFBOOT_PARTITION_SELF_HEADER_ADDRESS=0x8009C000
