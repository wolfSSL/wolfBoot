ARCH=sim
TARGET=sim
SIGN?=ED25519
HASH?=SHA256
WOLFBOOT_SMALL_STACK?=0
SPI_FLASH=0
EXT_FLASH=1
ENCRYPT=1
ENCRYPT_WITH_AES128=1
DEBUG=1

# Compressed update partition on external flash, encrypted at rest, boot
# partition executed in place from internal flash. ENCRYPT=1 hooks the
# external flash read, which is the same seam the installer and the image
# hasher pull the container through, so it is decrypted on its way in.
COMPRESSED_UPDATE=1

# LZ77 window the image was compressed with. The decoder needs twice this in
# RAM and refuses an image compressed with a larger one.
WOLFBOOT_COMPRESSED_WINDOW=16384

# UPDATE is sized for the container alone.
# sizes should be multiple of system page size
WOLFBOOT_PARTITION_SIZE=0x50000
WOLFBOOT_PARTITION_UPDATE_SIZE=0x2C000
WOLFBOOT_SECTOR_SIZE=0x1000
WOLFBOOT_PARTITION_BOOT_ADDRESS=0x80000
# on external flash, so it starts at the base of that device
WOLFBOOT_PARTITION_UPDATE_ADDRESS=0x00000
# No swap step in this mode; still reserved for the keytools.
WOLFBOOT_PARTITION_SWAP_ADDRESS=0x180000

# required for keytools
WOLFBOOT_FIXED_PARTITIONS=1
