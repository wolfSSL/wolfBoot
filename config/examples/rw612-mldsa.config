ARCH?=ARM
TZEN?=0
TARGET?=rw612
SIGN?=ML_DSA
ML_DSA_LEVEL?=5
IMAGE_SIGNATURE_SIZE?=4627
HASH?=SHA256
MCUXSDK?=1
MCUXPRESSO?=$(PWD)/../NXP/mcuxpresso-sdk/mcuxsdk
MCUXPRESSO_CMSIS?=$(MCUXPRESSO)/arch/arm/CMSIS
MCUXPRESSO_CPU?=RW612ETA2I
MCUXPRESSO_DRIVERS?=$(MCUXPRESSO)/devices/Wireless/RW/RW612
MCUXPRESSO_PROJECT_TEMPLATE?=$(MCUXPRESSO)/examples/_boards/frdmrw612/project_template
DEBUG?=0
DEBUG_UART?=1
VTOR?=1
CORTEX_M0?=0
CORTEX_M33?=1
NO_ASM?=0
NO_MPU=1
EXT_FLASH?=0
SPI_FLASH?=0
ALLOW_DOWNGRADE?=0
NVM_FLASH_WRITEONCE?=1
NO_ARM_ASM?=0
WOLFBOOT_VERSION?=0
V?=0
SPMATH?=1
RAM_CODE?=1
DUALBANK_SWAP?=0

IMAGE_HEADER_SIZE?=16384

# 16KB logical sectors (4 NOR erase sectors) to hold the 16KB image header
WOLFBOOT_SECTOR_SIZE?=0x4000

# 1MB boot, 1MB partitions, 16KB swap
WOLFBOOT_PARTITION_SIZE?=0x100000
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0x08100000
WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0x08200000
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0x08300000
