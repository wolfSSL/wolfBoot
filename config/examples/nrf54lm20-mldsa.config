ARCH?=ARM
TZEN?=0
TARGET?=nrf54l
SIGN?=ML_DSA
ML_DSA_LEVEL?=5
IMAGE_SIGNATURE_SIZE?=4627
IMAGE_HEADER_SIZE?=16384
HASH?=SHA256
WOLFBOOT_VERSION?=1
VTOR?=1
CORTEX_M0?=0
CORTEX_M33?=1
NO_ASM?=0
NO_MPU=1
ALLOW_DOWNGRADE?=0
NVM_FLASH_WRITEONCE?=0
DELTA_UPDATES?=0

SPMATH?=1
RAM_CODE?=1

DUALBANK_SWAP?=0
FLAGS_HOME=0
DISABLE_BACKUP=0
EXT_FLASH?=0
SPI_FLASH?=0
QSPI_FLASH?=0
UART_FLASH?=0

# ML-DSA-87 needs a 16 KB header, so sectors grow to 16 KB
WOLFBOOT_SECTOR_SIZE?=0x4000

# Reserve the first 128KB of internal flash for wolfBoot itself
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0x20000

# Application partitions split the remainder of the 2036K internal flash
WOLFBOOT_PARTITION_SIZE?=0xEC000

WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0x10C000

# One 16KB swap sector after the update partition
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0x1F8000

V?=0
DEBUG?=0
DEBUG_UART?=1
USE_GCC=1
OPTIMIZATION_LEVEL=2

# nRF54LM20 variant of the nrf54l HAL
CFLAGS_EXTRA+=-DNRF54LM20

# Use larger block size for swapping sectors (performance improvement)
CFLAGS_EXTRA+=-DFLASHBUFFER_SIZE=0x1000

#CFLAGS_EXTRA+=-DDEBUG_FLASH
