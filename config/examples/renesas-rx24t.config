ARCH?=RENESAS_RX
TARGET?=rx24t
SIGN?=ECC256
HASH?=SHA256
DEBUG?=0
DEBUG_UART?=1
VTOR?=1
NO_ASM?=0
NO_MPU=1
EXT_FLASH?=0
SPI_FLASH?=0
QSPI_FLASH?=0
ALLOW_DOWNGRADE?=0
NVM_FLASH_WRITEONCE?=1
WOLFBOOT_VERSION?=0
SPMATH?=1
RAM_CODE?=1
DUALBANK_SWAP?=0

# GNURX 14.2: gcc cannot drive the link, so ld is called directly
USE_GCC?=0

# reserve 1KB for wolfBoot header
# Requires building keytools with "make IMAGE_HEADER_SIZE=1024"
#IMAGE_HEADER_SIZE=1024

# Optionally switch to big endian data if MDE is set
#BIG_ENDIAN=1

# Flash is 256KB; partitions use the 2KB blocks
WOLFBOOT_SECTOR_SIZE?=0x800

# wolfBoot is last 32KB of flash and includes vector tables
WOLFBOOT_ORIGIN=0xFFFF8000

# wolfBoot partition size (32KB)
BOOTLOADER_PARTITION_SIZE=0x8000
# Application Partition Size (96KB, last two sectors hold the flags)
WOLFBOOT_PARTITION_SIZE?=0x18000

# Boot partition at the start of flash, update partition right after it
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0xFFFC0000
WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0xFFFD8000

# Swap sector
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0xFFFF0000

# No crypto hardware on RX24T
PKA?=0

# Include debug symbols (even for release build)
#DEBUG_SYMBOLS=1

# Optional option-setting memory (MDE/OFS1/OFS0 at 0xFFFFFF80), see docs
#CFLAGS_EXTRA+=-DWOLFBOOT_RENESAS_OSM

# Boot mode ID code at 0xFFFFFFA0: control code + ID codes 1-15
#RENESAS_ID_CODE?=450102030405060708090A0B0C0D0E0F

# External watchdog (e.g. MAX6316-MAX6322): toggle WDI from wolfBoot's long
# loops. WATCHDOG_WDI_PORT = RX port, WATCHDOG_WDI_PIN = bit (see renesas-rx.c).
#CFLAGS_EXTRA+=-DWATCHDOG -DWATCHDOG_WDI_PORT= -DWATCHDOG_WDI_PIN=
