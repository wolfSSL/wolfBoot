# ML-DSA-87 needs a 16 KB image header, so sectors grow to 16 KB (two
# 8 KB pages) and the bootloader to 128 KB.  Flash layout (2x512KB):
#   0x08000000: wolfBoot (128KB)
#   0x08020000: BOOT partition (432KB)
#   0x0808C000: UPDATE partition (432KB)
#   0x080F8000: SWAP (16KB)
WOLFBOOT_SECTOR_SIZE?=0x4000
WOLFBOOT_PARTITION_SIZE?=0x6C000
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0x08020000
WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0x0808C000
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0x080F8000
FLAGS_HOME=0
DISABLE_BACKUP=0
DEBUG_UART=1
