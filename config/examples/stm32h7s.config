# STM32H7S / STM32H7R (NUCLEO-H7S3L8 reference board)
#
# wolfBoot runs from the 64 KB internal flash at 0x08000000. All three
# partitions live on the external Octo-SPI NOR reached over XSPI2, which
# is memory mapped at 0x70000000, and the application executes in place
# from there.
#
# The boot partition is given its absolute memory-mapped address because
# the application's vector table has to be fetchable there. Update and
# swap are device-relative offsets. ext_flash_addr() in hal/stm32h7s.c
# accepts both forms.
#
# Board-specific values (NOR size, page and sector size, which XSPI
# instance, XSPI pins, UART) are overridable defaults in hal/stm32h7s.h;
# a board with a different NOR should not need to change the HAL body.
#
# On-board NOR is a Macronix MX25UW25645G, 32 MB, 4 KB erase subsector.
# Partition map on the device:
#   swap    0x00010000  0x1000
#   boot    0x00020000  0x400000   (0x70020000 memory mapped)
#   update  0x00420000  0x400000
ARCH?=ARM
TARGET?=stm32h7s
SIGN?=ECC256
HASH?=SHA256
DEBUG?=0
DEBUG_UART?=1
VTOR?=1
NO_ASM?=0
NO_MPU=1
SPI_FLASH?=0
QSPI_FLASH?=0
OCTOSPI_FLASH?=0
ALLOW_DOWNGRADE?=0
NVM_FLASH_WRITEONCE?=0
WOLFBOOT_VERSION?=1
V?=0
SPMATH?=1
# Deliberately 0. RAM_CODE compiles the bootloader self-update path in
# src/update_flash.c, which erases
# WOLFBOOT_PARTITION_BOOT_ADDRESS - ARCH_FLASH_OFFSET. With wolfBoot in
# internal flash and the partitions on the NOR that is 0x68020000, far
# past the 64 KB device, so the erase is rejected and the update would be
# written into flash that was never erased. The bootloader does not need
# RAMFUNCTION here: it runs from internal flash and only ever writes the
# external NOR. The test application does need it, and test-app/Makefile
# sets -DRAM_CODE for this target directly.
RAM_CODE?=0
WOLFBOOT_SECTOR_SIZE?=0x1000
WOLFBOOT_PARTITION_SIZE?=0x400000
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0x70020000
WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0x00420000
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0x00010000
IMAGE_HEADER_SIZE?=1024
BOOTLOADER_PARTITION_SIZE=0x10000
# Boot, update and swap are on the same physical NOR. PART_BOOT_EXT keeps
# every boot-partition access on the ext_flash_* path so no read depends
# on the memory-mapped window, which an update tears down.
CFLAGS_EXTRA+=-DPART_BOOT_EXT
# Print registers over the console if the bootloader faults
CFLAGS_EXTRA+=-DDEBUG_HARDFAULT
