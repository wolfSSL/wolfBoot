# Raspberry Pi CM5 (BCM2712) - Linux FIT boot with RAUC A/B rootfs slots.
#
# cm5_emmc_linux.config plus RAUC slot selection: wolfBoot reads BOOT_ORDER and
# the BOOT_x_LEFT try counters from a raw U-Boot env partition, decrements the
# chosen slot and passes root= and rauc.slot= to the kernel. The FIT is shared.
ARCH?=AARCH64
TARGET?=cm5
SIGN?=ECC384
HASH?=SHA384
IMAGE_HEADER_SIZE?=1024
DEBUG?=0
DEBUG_UART?=1
DISK_SDCARD?=0
DISK_EMMC?=1
CFLAGS_EXTRA+=-DSDHCI_FORCE_CARD_DETECT
CFLAGS_EXTRA+=-DSDHCI_SDMA_DISABLED
CFLAGS_EXTRA+=-DSDHCI_WRITE_SINGLE_BLOCK
CFLAGS_EXTRA+=-DSDHCI_TC_OVER_DATA_TIMEOUT
CFLAGS_EXTRA+=-DSDHCI_WRITE_SETTLE_SPINS=1000000U
EXT_FLASH?=0
NO_XIP=1
NO_QNX?=1
ELF?=1
VTOR?=1
SPMATH?=1
PKA?=0
WOLFTPM?=0
WOLFBOOT_NO_PARTITIONS=1
# GPT partition indexes (0-based): 0 = FAT boot, 1 = U-Boot env, 2 = FIT,
# 3 = rootfs A, 4 = rootfs B
CFLAGS_EXTRA+=-DBOOT_PART_A=2
CFLAGS_EXTRA+=-DBOOT_PART_B=2
CFLAGS_EXTRA+=-DDISK_BLOCK_SIZE=0x80000
GZIP?=1
# Linux is entered at EL2, the level the firmware starts every CPU at.
CFLAGS_EXTRA+=-DRPI_FIRMWARE_DTB
# The full command line is:
#   earlycon=pl011,mmio32,0x107d001000 console=ttyAMA10,115200
#   root=<LINUX_BOOTARGS_ROOT> rootfstype=ext4 rootwait
# Fallback root if the env cannot be read (normally root= comes from the slot).
CFLAGS_EXTRA+=-DLINUX_BOOTARGS_ROOT=\"/dev/mmcblk0p4\"
# RPI_RAUC_AB is a make variable: arch.mk links src/ubootenv.o and defines it.
RPI_RAUC_AB?=1
# Match the RAUC fw_env.config and system.conf of the image.
CFLAGS_EXTRA+=-DRPI_UBOOT_ENV_PART=1
CFLAGS_EXTRA+=-DRPI_ROOT_A=\"/dev/mmcblk0p4\"
CFLAGS_EXTRA+=-DRPI_ROOT_B=\"/dev/mmcblk0p5\"
# Stage the FIT above the decompressed kernel (load 0x10000000), or gunzip
# overwrites its own input.
WOLFBOOT_LOAD_ADDRESS?=0x18000000
WOLFBOOT_RAMBOOT_MAX_SIZE=0x23C00000
WOLFBOOT_LOAD_DTS_ADDRESS?=0x08000000
WOLFBOOT_PARTITION_BOOT_ADDRESS=0x80200000
WOLFBOOT_PARTITION_SIZE=0x4000000
WOLFBOOT_SECTOR_SIZE=0x1000
