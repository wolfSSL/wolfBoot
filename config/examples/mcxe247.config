# wolfBoot configuration for NXP MCX E247 (FRDM-MCXE247)
#
# MCXE247: Cortex-M4F, 2MB flash (1.5MB Program Flash + 512KB FlexNVM), 256KB
# SRAM. It is register compatible with the S32K148 and uses the s32k1xx HAL.
# Default: RUN mode at 80 MHz (crystal + SPLL); the wolfIP speed test uses HSRUN
# at 112 MHz.
#
# Build: cp config/examples/mcxe247.config .config && make

ARCH?=ARM
CORTEX_M4?=1
NO_MPU=1
TARGET?=s32k1xx
SIGN?=ECC256
HASH?=SHA256
VTOR?=1
NO_ASM?=0
EXT_FLASH?=0
SPI_FLASH?=0
ALLOW_DOWNGRADE?=0

# Flash can be programmed only once between erases
NVM_FLASH_WRITEONCE?=1

WOLFBOOT_VERSION?=0
V?=0
SPMATH?=1
RAM_CODE?=1
DUALBANK_SWAP?=0

# Select the MCXE247 variant. SRAM is ECC protected and holds no valid ECC after
# power-on. WOLFBOOT_RAM_ECC_INIT clears the SRAM the bootloader uses
# (0x1FFFC000-0x20002FFF) at reset so its ECC is valid. The rest of SRAM is the
# application's to initialize (see APP_RAM_ECC_INIT).
CFLAGS_EXTRA+=-DMCXE247 -DWOLFBOOT_RAM_ECC_INIT

# Word-at-a-time memcpy/memset in src/string.c (bootloader and test-app). The
# Cortex-M4 loads unaligned words, so memcpy copies words even when source and
# destination alignments differ; about doubles the wolfIP network test rates.
CFLAGS_EXTRA+=-DFAST_MEMCPY

# Run at 80 MHz from the 8 MHz crystal (SOSC + SPLL) with the 4 KB flash code
# cache on. wolfBoot returns clock and cache to their reset state before it
# starts the application; the test-app then switches both on again.
# Remove to run from the 48 MHz internal oscillator.
CFLAGS_EXTRA+=-DS32K1XX_CLOCK_80MHZ -DS32K1XX_CODE_CACHE

# The wolfIP speed test runs in HSRUN at 112 MHz (bus 56 MHz, flash 28 MHz)
# and returns to RUN at 80 MHz when it stops. Flash cannot be programmed in
# HSRUN, so the console commands that write flash run at 80 MHz.
CFLAGS_EXTRA+=-DS32K1XX_HSRUN_SPEED_TEST

# 4KB sectors
WOLFBOOT_SECTOR_SIZE?=0x1000

# The application's vector table follows the image header and is used in
# place (VTOR). The table must be 1 KB aligned, or the core fetches the vectors
# of IRQ 48 and up from the wrong slots.
IMAGE_HEADER_SIZE?=1024

# Memory layout (Program Flash 0x00000000 - 0x0017FFFF):
#   Bootloader:       0x00000000 - 0x0000BFFF (48 KB)
#   Boot Partition:   0x0000C000 - 0x000C3FFF (736 KB)
#   Update Partition: 0x000C4000 - 0x0017BFFF (736 KB)
#   Swap Sector:      0x0017C000 - 0x0017CFFF (4 KB)
WOLFBOOT_PARTITION_SIZE?=0xB8000
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0xC000
WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0xC4000
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0x17C000

# Console on the MCU-Link VCOM port: LPUART2, PTE12 (TX) and PTD17 (RX), ALT3
CFLAGS_EXTRA+=-DDEBUG_UART_NUM=2
CFLAGS_EXTRA+=-DDEBUG_UART_TX_PORT=S32K_PORT_E -DDEBUG_UART_TX_PIN=12
CFLAGS_EXTRA+=-DDEBUG_UART_TX_MUX=PORT_PCR_MUX_ALT3
CFLAGS_EXTRA+=-DDEBUG_UART_RX_PORT=S32K_PORT_D -DDEBUG_UART_RX_PIN=17
CFLAGS_EXTRA+=-DDEBUG_UART_RX_MUX=PORT_PCR_MUX_ALT3

# wolfIP network test in the test-app (optional)
# Adds the "network" console command. Needs a wolfIP checkout, which provides
# the interrupt-driven nxp_mcxe_enet driver.
ENABLE_WOLFIP?=0
WOLFBOOT_LIB_WOLFIP?=../lib/wolfip
# By default the command acquires a DHCP lease and runs a TCP and UDP
# throughput server on port 9, driven from the host by
# tools/scripts/wolfip_speed.py.
WOLFIP_SPEED_TEST?=1
# WOLFBOOT_TEST_TFTP=1 makes the command fetch a file over TFTP instead (it
# overrides WOLFIP_SPEED_TEST). The file must fit the 40 KB receive buffer.
# With both set to 0 the command only acquires a DHCP lease.
WOLFBOOT_TEST_TFTP?=0
CFLAGS_EXTRA+=-DHOST_IP_STR='"192.168.50.1"' -DTFTP_FILENAME='"wolfip_test.bin"'

# Debugging options
DEBUG?=0
DEBUG_SYMBOLS?=0
DEBUG_UART?=1
