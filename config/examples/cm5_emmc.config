# Raspberry Pi CM5 (BCM2712) - A/B disk boot from the onboard eMMC.
#
# wolfBoot reads the signed A/B images from GPT partitions on the eMMC through
# the generic SDHCI driver (src/sdhci.c + the hal/cm5.c glue).
ARCH?=AARCH64
TARGET?=cm5
SIGN?=ECC384
HASH?=SHA384
IMAGE_HEADER_SIZE?=1024
DEBUG?=0
DEBUG_UART?=1
DISK_SDCARD?=0
DISK_EMMC?=1
# The eMMC is soldered down; there is no card-detect line.
CFLAGS_EXTRA+=-DSDHCI_FORCE_CARD_DETECT
# PIO transfers: the HAL has no DMA cache-maintenance hooks.
CFLAGS_EXTRA+=-DSDHCI_SDMA_DISABLED
# One block per write command: the BCM2712 controller flags a data timeout
# when the eMMC acknowledges a block and stops a multi-block write there. A
# single-block write also sets Transfer Complete, which the second option
# accepts as completed.
CFLAGS_EXTRA+=-DSDHCI_WRITE_SINGLE_BLOCK
CFLAGS_EXTRA+=-DSDHCI_TC_OVER_DATA_TIMEOUT
CFLAGS_EXTRA+=-DSDHCI_WRITE_SETTLE_SPINS=1000000U
#CFLAGS_EXTRA+=-DDEBUG_SDHCI
#CFLAGS_EXTRA+=-DDEBUG_DISK
#CFLAGS_EXTRA+=-DDEBUG_GPT
EXT_FLASH?=0
NO_XIP=1
NO_QNX?=1
ELF?=1
VTOR?=1
SPMATH?=1
PKA?=0
WOLFTPM?=0
WOLFBOOT_NO_PARTITIONS=1
# GPT partition indexes (0-based): 0 = FAT boot, 1 = image A, 2 = image B
CFLAGS_EXTRA+=-DBOOT_PART_A=1
CFLAGS_EXTRA+=-DBOOT_PART_B=2
CFLAGS_EXTRA+=-DDISK_BLOCK_SIZE=0x80000
WOLFBOOT_LOAD_ADDRESS?=0x10000000
WOLFBOOT_RAMBOOT_MAX_SIZE=0x2BC00000
WOLFBOOT_LOAD_DTS_ADDRESS?=0x08000000
WOLFBOOT_PARTITION_BOOT_ADDRESS=0x80200000
WOLFBOOT_PARTITION_SIZE=0x4000000
WOLFBOOT_SECTOR_SIZE=0x1000
