# NUCLEO-F439ZI with a compressed update partition, executing in place.
#
# Both partitions stay inside the first 1MB: hal/stm32f4.c describes only
# that much flash, because the second bank's sector numbers are not
# contiguous with the first's. A layout past it is refused at build time.
#
# Console is USART3 on PD8/PD9, the ST-LINK virtual COM port on the
# NUCLEO-144 boards.
ARCH?=ARM
TARGET?=stm32f4
SIGN?=ED25519
HASH?=SHA256
DEBUG?=1
DEBUG_UART?=1
CFLAGS_EXTRA+=-DUSE_UART3
VTOR?=1
NVM_FLASH_WRITEONCE?=0
SPMATH?=1

# 168MHz from an 8MHz HSE, the NUCLEO-144 default.
CLOCK_SPEED?=168000000
STM32_PLLM?=8
STM32_PLLN?=336
STM32_PLLP?=2
STM32_PLLQ?=7

# Implies DISABLE_BACKUP: no swap, and no backup of the outgoing image.
COMPRESSED_UPDATE?=1

# LZ77 window the image was compressed with: 32KB of bss on a part with
# 192KB of SRAM. Sign with 'sign --compress=14' to match.
WOLFBOOT_COMPRESSED_WINDOW?=16384

# UPDATE is sized for the container alone. The split has to cover the worst
# ratio the product will ever ship; the signing tool refuses an artifact
# that does not fit, so a bad split fails at build time, not on the device.
WOLFBOOT_SECTOR_SIZE?=0x20000
WOLFBOOT_PARTITION_SIZE?=0x80000
WOLFBOOT_PARTITION_UPDATE_SIZE?=0x60000
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0x08020000
WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0x080A0000
# No swap step in this mode, so no swap partition is reserved.
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0

# required for keytools
WOLFBOOT_FIXED_PARTITIONS=1
