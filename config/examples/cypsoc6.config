ARCH?=ARM
TARGET?=psoc6
PSOC6_BOARD?=CY8CKIT_062S2_43012
SIGN?=ECC256
HASH?=SHA256
CYPRESS_PDL?=$(WOLFBOOT_ROOT)/lib/mtb-pdl-cat1
CYPRESS_CMSIS?=$(WOLFBOOT_ROOT)/lib/cmsis
CYPRESS_TEMPLATE_LIB?=$(WOLFBOOT_ROOT)/lib/mtb-template-cat1
CYPRESS_CORE_LIB?=$(WOLFBOOT_ROOT)/lib/core-lib
DEBUG?=0
DEBUG_UART?=1
VTOR?=1
NO_MPU?=1
FLAGS_INVERT?=1
CORTEX_M0?=1
NO_ASM?=0
EXT_FLASH?=0
SPI_FLASH?=0
NO_XIP?=0
UART_FLASH?=0
ALLOW_DOWNGRADE?=0
NVM_FLASH_WRITEONCE?=1
WOLFBOOT_VERSION?=0
V?=0
SPMATH?=1
RAM_CODE?=0
DUALBANK_SWAP?=0
PKA?=0
WOLFTPM?=0
PSOC6_CRYPTO?=0
# wolfBoot 0x10000000 (128 KB), BOOT 0x10020000 and UPDATE 0x10100000
# (896 KB each), SWAP 0x101E0000 (one 4 KB subsector)
WOLFBOOT_PARTITION_SIZE?=0xE0000
WOLFBOOT_SECTOR_SIZE?=0x1000
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0x10020000
WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0x10100000
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0x101E0000
