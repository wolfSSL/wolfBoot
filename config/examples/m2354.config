ARCH?=ARM
TZEN?=0
TARGET?=m2354
SIGN?=ECC256
HASH?=SHA256
DEBUG?=0
VTOR?=1
CORTEX_M23?=1
NO_ASM?=0
NO_ARM_ASM?=1
NO_MPU=1
EXT_FLASH?=0
SPI_FLASH?=0
ALLOW_DOWNGRADE?=0
NVM_FLASH_WRITEONCE?=1
WOLFBOOT_VERSION?=1
V?=0
SPMATH?=1
RAM_CODE?=1
DUALBANK_SWAP?=0
# Flash layout (1MB APROM, 2KB pages, two 512KB banks):
#   0x00000000  wolfBoot          (64KB)
#   0x00010000  BOOT partition    (448KB)
#   0x00080000  UPDATE partition  (448KB)  - starts on the bank 1 boundary
#   0x000F0000  SWAP              (2KB, one page)
# The application's vector table must be aligned to a power of two at least
# its own size, because do_boot() programs VTOR with the application address
# and the low bits of VTOR are RES0. The M2354 implements 132 exceptions
# (16 system + 116 external) = 528 bytes, so the next power of two is 1024.
# The wolfBoot default of 256 would leave the table only 256-aligned and
# exception fetches would resolve to the wrong address.
IMAGE_HEADER_SIZE?=1024

WOLFBOOT_SECTOR_SIZE?=0x800
WOLFBOOT_PARTITION_SIZE?=0x70000
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0x10000
WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0x80000
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0xF0000
FLAGS_HOME=0
DISABLE_BACKUP=0
DEBUG_UART=1
