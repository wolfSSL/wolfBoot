ARCH?=ARM
TZEN?=1
TARGET?=mcxw
SIGN?=ECC256
HASH?=SHA256
MCUXSDK?=1
MCUXPRESSO?=$(PWD)/../NXP/mcuxpresso-sdk/mcuxsdk
MCUXPRESSO_CMSIS?=$(MCUXPRESSO)/arch/arm/CMSIS
MCUXPRESSO_CPU?=MCXW716CMFTA
MCUXPRESSO_DRIVERS?=$(MCUXPRESSO)/devices/MCX/MCXW/MCXW716C
MCUXPRESSO_PROJECT_TEMPLATE?=$(MCUXPRESSO)/examples/_boards/frdmmcxw71/project_template
DEBUG?=0
DEBUG_UART?=1
VTOR?=1
CORTEX_M0?=0
CORTEX_M33?=1
NO_ASM?=0
NO_ARM_ASM?=0
NO_MPU=1
EXT_FLASH?=0
SPI_FLASH?=0
ALLOW_DOWNGRADE?=0
NVM_FLASH_WRITEONCE?=1
WOLFBOOT_VERSION?=0
V?=0
SPMATH?=1
RAM_CODE?=1
DUALBANK_SWAP?=0

# 8KB sectors
WOLFBOOT_SECTOR_SIZE?=0x2000

# 192KB wolfBoot, 8KB NSC, 352KB partitions, 8KB swap, 96KB keyvault
# The keyvault holds the default 20 PKCS11 objects and sits outside the range
# erased by a bootloader self-update; 0xFE000 holds the NXP PROD_DATA
WOLFBOOT_NSC_ADDRESS?=0x30000
WOLFBOOT_NSC_SIZE?=0x2000
WOLFBOOT_PARTITION_SIZE?=0x58000
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0x32000
WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0x8A000
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0xE2000
WOLFBOOT_KEYVAULT_ADDRESS?=0xE4000
WOLFBOOT_KEYVAULT_SIZE?=0x18000
