ARCH?=ARM
TZEN?=1
TARGET?=lpc55s69
SIGN?=ECC384
HASH?=SHA256
IMAGE_HEADER_SIZE?=512
MCUXSDK?=1
MCUXPRESSO?=$(PWD)/../NXP/mcuxpresso-sdk/mcuxsdk
MCUXPRESSO_CMSIS?=$(PWD)/../NXP/CMSIS_5/CMSIS
MCUXPRESSO_CPU?=LPC55S69JBD100_cm33_core0
MCUXPRESSO_DRIVERS?=$(MCUXPRESSO)/devices/LPC/LPC5500/LPC55S69
MCUXPRESSO_PROJECT_TEMPLATE?=$(MCUXPRESSO)/examples/_boards/lpcxpresso55s69/project_template
DEBUG?=0
DEBUG_UART?=1
VTOR?=1
CORTEX_M0?=0
CORTEX_M33?=1
NO_ASM?=0
NO_MPU=1
EXT_FLASH?=0
SPI_FLASH?=0
ALLOW_DOWNGRADE?=0
NVM_FLASH_WRITEONCE?=1
# The Thumb-2 SHA assembly is slower than C on this part; the SP math uses DSP
NO_ARM_ASM?=1
WOLFBOOT_VERSION?=0
V?=0
SPMATH?=1
RAM_CODE?=1
DUALBANK_SWAP?=0
FLASH_MULTI_SECTOR_ERASE?=1
WOLFCRYPT_TZ?=1
WOLFCRYPT_TZ_PSA?=1

WOLFBOOT_ATTESTATION_TEST?=1
WOLFBOOT_UDS_UID_FALLBACK_FORTEST?=1

# Turn on or off hw acceleration of crypto algs in the lpc55s69
PKA?=0
# Turn on or off hw puf
HWPUF?=0
WOLFBOOT_HWPUF_PROVISION?=0

WOLFBOOT_SECTOR_SIZE?=0x200

# 248KB wolfBoot, 8KB NSC, 128KB partitions on the 32KB AHB secure rule grid,
# 0x80000-0x80FFF free for the HWPUF record, 512B swap, 88KB keyvault
WOLFBOOT_NSC_ADDRESS?=0x1003E000
WOLFBOOT_NSC_SIZE?=0x2000
WOLFBOOT_PARTITION_SIZE?=0x20000
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0x00040000
WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0x00060000
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0x00081000
WOLFBOOT_KEYVAULT_ADDRESS?=0x10082000
WOLFBOOT_KEYVAULT_SIZE?=0x16000
