ARCH?=ARM
TARGET?=psoc_c3
SIGN?=ML_DSA
ML_DSA_LEVEL?=5
IMAGE_SIGNATURE_SIZE?=4627
IMAGE_HEADER_SIZE?=16384
HASH?=SHA256
DEBUG?=0
VTOR?=1
CORTEX_M33?=1
TZEN?=0
NO_ASM?=0
NO_MPU=1
EXT_FLASH?=0
SPI_FLASH?=0
ALLOW_DOWNGRADE?=0
NVM_FLASH_WRITEONCE?=0
# This family erases flash to 0x00; see psoc_c3.config.
FLAGS_INVERT?=1

WOLFBOOT_VERSION?=1
V?=0
SPMATH?=1
RAM_CODE?=1
DUALBANK_SWAP?=0
DEBUG_UART=1

# ML-DSA-87 needs a 16 KB header, so the logical sector grows from one 512 B
# row to 32 rows. The larger bootloader and partitions use the whole 512 KB
# part, past the 256 KB the published debugger flash algorithms cover.
#
#   0x12000000 - 0x1201FFFF  wolfBoot          (128 KB)
#   0x12020000 - 0x1204BFFF  BOOT              (0x2C000)
#   0x1204C000 - 0x12077FFF  UPDATE            (0x2C000)
#   0x12078000 - 0x1207BFFF  SWAP              (16 KB)
WOLFBOOT_SECTOR_SIZE?=0x4000
WOLFBOOT_PARTITION_SIZE?=0x2C000
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0x12020000
WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0x1204C000
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0x12078000
