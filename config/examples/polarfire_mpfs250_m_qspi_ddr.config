# PolarFire SoC MPFS250T M-Mode (Machine Mode) with LPDDR4 + SC QSPI
#
# Standalone wolfBoot replacing HSS, booting Linux from QSPI instead of a
# disk.  polarfire_mpfs250_m_qspi.config is the other QSPI M-mode build: it
# runs an application out of the L2 scratchpad and never brings up DDR.  This
# one is the HSS-replacement configuration with QSPI as the image store, so it
# uses src/update_ram.c rather than src/update_disk.c and keeps the A/B update
# slots the disk configuration does not have.
#
# Standalone wolfBoot replacing HSS:
#   1. eNVM (0x20220100) -> L2_SCRATCH (0x0A000000) - wolfBoot starts
#   2. M-mode init: PLLs, DDR controller, LPDDR4 training (Video Kit)
#   3. Load signed FIT from QSPI to DDR staging (0x82000000); after verify,
#      kernel -> 0x80200000 (FIT "load"), DTB -> 0x8A000000
#   4. Verify ECC384/SHA384 signature
#   5. Drop to S-mode and jump to kernel
#
# The slots are sized for a Linux FIT: 48 MB each in the Video Kit's 128 MB
# MT25QL01G, which the 32 MB slots of the application configuration cannot
# hold.  Writing a slot that size over the UART programmer is impractical, so
# UART_QSPI_PROGRAM is off here; write QSPI from a running Linux (the SBI
# vendor extension flash services, MPFS_SBI_VENDOR=1) or from a programmer.
#
# Flash via mpfsBootmodeProgrammer (bootmode 1):
#   java -jar mpfsBootmodeProgrammer.jar --bootmode 1 --die MPFS250T \
#        --package FCG1152 --workdir $PWD wolfboot.elf

ARCH?=RISCV64
TARGET?=mpfs250
SIGN?=ECC384
HASH?=SHA384
IMAGE_HEADER_SIZE=512
WOLFBOOT_VERSION?=1
ARMORED?=0
DEBUG?=0
DEBUG_SYMBOLS?=1
DEBUG_UART?=1
VTOR?=1
EXT_FLASH?=1
SPI_FLASH?=0
NO_XIP?=1
NVM_FLASH_WRITEONCE?=0
UART_FLASH?=0
UART_QSPI_PROGRAM?=0
V?=0
NO_MPU?=1
RAM_CODE?=0
SPMATH?=0
SPMATHALL?=1
DUALBANK_SWAP?=0
PKA?=0
ENCRYPT=0
WOLFTPM?=0
ELF?=1
OPTIMIZATION_LEVEL=1
RISCV_MMODE?=1
STACK_SIZE_PER_HART=4096
NO_ASM?=0
LIBERO_FPGA_CONFIG_DIR?=
CFLAGS_EXTRA+=-DWOLFBOOT_MMODE_SMODE_BOOT
CFLAGS_EXTRA+=-DMPFS_SC_SPI
DISK_SDCARD?=0
DISK_EMMC?=0
WOLFBOOT_ORIGIN?=0x0A000000
WOLFBOOT_L2SCRATCH_SIZE?=512k
STACK_SIZE?=64k
WOLFBOOT_SECTOR_SIZE?=0x10000
WOLFBOOT_LOAD_ADDRESS?=0x82000000
WOLFBOOT_LOAD_DTS_ADDRESS?=0x8A000000
WOLFBOOT_RAMBOOT_MAX_SIZE=0x08000000
WOLFBOOT_PARTITION_BOOT_ADDRESS=0x100000
WOLFBOOT_PARTITION_SIZE=0x3000000
WOLFBOOT_PARTITION_UPDATE_ADDRESS=0x3100000
WOLFBOOT_PARTITION_SWAP_ADDRESS=0x6100000
# Standalone DTB regions after the swap, as polarfire_mpfs250_qspi.config has
# them.  A FIT carries its own fdt sub-image and never reaches these; they are
# the fallback for booting a plain kernel image out of QSPI.
WOLFBOOT_DTS_BOOT_ADDRESS=0x6110000
WOLFBOOT_DTS_UPDATE_ADDRESS=0x6120000
CFLAGS_EXTRA+=-DDEBUG_BOOT
