ARCH?=ARM
TZEN?=1
TARGET?=stm32l5
SIGN?=ECC256
HASH?=SHA256
DEBUG?=0
DEBUG_UART?=0
VTOR?=1
CORTEX_M0?=0
CORTEX_M33?=1
NO_ASM?=0
NO_MPU=1
EXT_FLASH?=0
SPI_FLASH?=0
ALLOW_DOWNGRADE?=0
NVM_FLASH_WRITEONCE?=1
WOLFBOOT_VERSION?=1
V?=0
SPMATH?=1
# No bootloader self-update: its erase range assumes the non-secure alias
RAM_CODE?=0
DUALBANK_SWAP?=0
IMAGE_HEADER_SIZE?=1024
WOLFCRYPT_TZ?=0
ARMORED=1

WOLFBOOT_SECURE_APP?=1
WOLFBOOT_SECURE_HANDOFF_ADDRESS?=0x30000000
# The secure app runs on the 110 MHz PLL clock wolfBoot leaves running
WOLFBOOT_RESTORE_CLOCK?=0

# 2KB pages, dual bank (DBANK=1)
WOLFBOOT_SECTOR_SIZE?=0x800

# 48KB wolfBoot region with no NSC, partitions at the Secure flash alias:
# 128KB boot and the swap page in bank 1, 128KB update in bank 2.
# 0x0C038000-0x0C03DFFF is the secure app's NVM and is never touched here.
BOOTLOADER_PARTITION_SIZE?=0xC000
WOLFBOOT_KEYVAULT_ADDRESS?=0x0C00B000
WOLFBOOT_KEYVAULT_SIZE?=0
WOLFBOOT_PARTITION_SIZE?=0x20000
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0x0C00C000
WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0x0C040000
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0x0C03E000
