# PolarFire SoC MPFS250T Icicle Kit, M-mode System Controller probe
#
# The MPFS-ICICLE-KIT carries a non-secure die (MPFS250T_ES / MPFS250T) with
# no Athena/TeraFire user crypto co-processor, where the Video Kit configs in
# this directory assume an MPFS250TS secure die. This configuration exists to
# establish which System Controller services that die actually serves: the
# sNVM page survey, the device serial number, the SRAM-PUF and the TRNG.
#
# It carries no image source on purpose. wolfBoot runs hal_init(), which is
# where the survey happens, and then has nothing to boot - that is expected.
# MPFS_ATHENA is deliberately absent: there is no co-processor to drive.
#
# The service probe (MPFS_SC_PROBE: serial number, TRNG nonce, PUF emulation)
# is on by default in every M-mode build. The sNVM page survey is a make
# argument, not a config setting:
#   cp config/examples/polarfire_mpfs250_icicle.config .config
#   make CROSS_COMPILE=riscv64-unknown-elf- MPFS_SNVM_DUMP=1 \
#        MPFS_SNVM_DUMP_FIRST=0 MPFS_SNVM_DUMP_COUNT=221
#
# Both need RISCV_MMODE=1 (options.mk): under HSS the System Controller
# mailbox belongs to HSS, so an S-mode build is refused.
#
# No DDR: LIBERO_FPGA_CONFIG_DIR is deliberately unset, so MPFS_DDR_INIT is
# off and hal/mpfs250_ddr.o is not linked. The Icicle's own Libero export is
# a later step; the System Controller does not need DDR.

ARCH?=RISCV64
TARGET?=mpfs250
SIGN?=ECC384
HASH?=SHA384
IMAGE_HEADER_SIZE=512
WOLFBOOT_VERSION?=1
ARMORED?=0
DEBUG?=0
DEBUG_SYMBOLS?=1
DEBUG_UART?=1
VTOR?=1
NO_XIP?=1
NVM_FLASH_WRITEONCE?=0
UART_FLASH?=0
V?=0
NO_MPU?=1
RAM_CODE?=0
SPMATH?=0
SPMATHALL?=1
DUALBANK_SWAP?=0
PKA?=0
ENCRYPT=0
WOLFTPM?=0
ELF?=1
STRIP_ELF?=1
OPTIMIZATION_LEVEL=1
RISCV_MMODE?=1
STACK_SIZE_PER_HART=0
NO_ASM?=1

# The Video Kit's flash hangs off the System Controller QSPI and its configs
# set EXT_FLASH=1 with -DMPFS_SC_SPI. The Icicle's is on the MSS QSPI
# controller instead, so neither applies here, and the probe needs no flash.
EXT_FLASH?=0
SPI_FLASH?=0
DISK_SDCARD?=0
DISK_EMMC?=0

# wolfBoot executes from the L2 scratchpad, as on the Video Kit: the four
# pinned scratchpad ways the startup in src/boot_riscv_start.S sets up.
WOLFBOOT_ORIGIN?=0x0A000000
WOLFBOOT_LOAD_ADDRESS?=0x0A020200
WOLFBOOT_SECTOR_SIZE?=0x10000
WOLFBOOT_PARTITION_SIZE?=0x1FE0000
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0x20000
WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0x2000000
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0x4000000
CFLAGS_EXTRA+=-DWOLFBOOT_SHA_BLOCK_SIZE=4096
