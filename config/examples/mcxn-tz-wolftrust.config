ARCH?=ARM
TZEN?=1
TARGET?=mcxn
SIGN?=ECC256
HASH?=SHA256
MCUXSDK?=1
MCUXPRESSO?=$(PWD)/../NXP/mcuxpresso-sdk/mcuxsdk
MCUXPRESSO_CMSIS?=$(PWD)/../NXP/CMSIS_5/CMSIS
MCUXPRESSO_CPU?=MCXN947VDF_cm33_core0
MCUXPRESSO_DRIVERS?=$(MCUXPRESSO)/devices/MCX/MCXN/MCXN947
MCUXPRESSO_PROJECT_TEMPLATE?=$(MCUXPRESSO)/examples/_boards/frdmmcxn947/project_template
DEBUG?=0
DEBUG_UART?=1
VTOR?=1
CORTEX_M0?=0
CORTEX_M33?=1
NO_ASM?=0
NO_MPU=1
EXT_FLASH?=0
SPI_FLASH?=0
ALLOW_DOWNGRADE?=0
NVM_FLASH_WRITEONCE?=1
NO_ARM_ASM=1
WOLFBOOT_VERSION?=0
V?=0
SPMATH?=1
RAM_CODE?=1
DUALBANK_SWAP?=0
IMAGE_HEADER_SIZE?=1024
WOLFCRYPT_TZ?=0

WOLFBOOT_SECURE_APP?=1
WOLFBOOT_SECURE_HANDOFF_ADDRESS?=0x30030000

# 8KB sectors
WOLFBOOT_SECTOR_SIZE?=0x2000

# 256KB wolfBoot region (bootloader + empty NSC), partitions at the Secure
# flash alias: 256KB boot, 256KB update in bank 1, 8KB swap
BOOTLOADER_PARTITION_SIZE?=0x40000
WOLFBOOT_KEYVAULT_ADDRESS?=0x20000
WOLFBOOT_KEYVAULT_SIZE?=0
WOLFBOOT_NSC_ADDRESS?=0x20000
WOLFBOOT_NSC_SIZE?=0x2000
WOLFBOOT_PARTITION_SIZE?=0x40000
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0x10040000
WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0x10180000
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0x101C0000
