# TechNexion PICO-IMX8MM (i.MX 8M Mini). See docs/Targets.md.
ARCH?=AARCH64
TARGET?=imx8mm
SIGN?=RSA4096
HASH?=SHA3
DEBUG?=1
VTOR?=1
SPMATH?=1
IMAGE_HEADER_SIZE?=1024
PKA?=1
WOLFTPM?=0
# Console on UART2. DEBUG_UART=0 also needs -DWOLFBOOT_NO_PRINTF.
DEBUG_UART?=1
# Linux-targeted toolchains: no glibc FORTIFY calls, no PIE
CFLAGS_EXTRA+=-U_FORTIFY_SOURCE -fno-pie
LDFLAGS_EXTRA+=-no-pie
NO_XIP?=1
NO_QNX?=1
WOLFBOOT_SECTOR_SIZE=0x400
WOLFBOOT_NO_PARTITIONS=1
# IMX8MM_BL33=1: started by ATF as BL33, in place of U-Boot proper
# IMX8MM_BL33=0: started from U-Boot proper ("go 0x40480000")
IMX8MM_BL33?=1
ifeq ($(IMX8MM_BL33),1)
  # BL33 address (U-Boot CONFIG_TEXT_BASE)
  WOLFBOOT_LOAD_BASE?=0x40200000
  # DISK_EMMC=0: signed kernel placed by SPL
  IMX8MM_KERNEL_ADDR?=0x48000000
  # 64 MB: up to 0x48000000 from the kernel run address
  WOLFBOOT_RAMBOOT_MAX_SIZE?=0x4000000
  CFLAGS_EXTRA+=-DIMX8MM_BL33
  # Entered with the MMU off
  CFLAGS_EXTRA+=-mstrict-align
  # Identity MMU + D-cache while loading and verifying
  IMX8MM_MMU?=1
  ifeq ($(IMX8MM_MMU),1)
    CFLAGS_EXTRA+=-DIMX8MM_MMU
  endif
  # Signed FIT read from eMMC (uSDHC3) p1, FAT32
  DISK_EMMC?=1
  ifeq ($(DISK_EMMC),1)
    CFLAGS_EXTRA+=-DSDHCI_FORCE_CARD_DETECT
    # Print the eMMC bus and partitions at boot
    CFLAGS_EXTRA+=-DIMX8MM_EMMC_PROBE
    # 8-bit, High Speed (50 MHz)
    IMX8MM_EMMC_HS?=1
    ifeq ($(IMX8MM_EMMC_HS),1)
      CFLAGS_EXTRA+=-DSDHCI_EMMC_BUS_WIDTH=8 -DSDHCI_EMMC_HS
    endif
    DISK_FS?=fat32
    CFLAGS_EXTRA+=-DBOOT_PART_A=0 -DBOOT_PART_B=0
    CFLAGS_EXTRA+=-DBOOT_FILE_A='"/fitImage_A.itb"'
    CFLAGS_EXTRA+=-DBOOT_FILE_B='"/fitImage_B.itb"'
    # Whole FIT is read and verified here
    WOLFBOOT_LOAD_ADDRESS?=0x48000000
    # 64 KB SDMA reads
    DISK_BLOCK_SIZE?=65536
    CFLAGS_EXTRA+=-DDISK_BLOCK_SIZE=$(DISK_BLOCK_SIZE)
    # Keep WOLFBOOT_FS_CACHE_SIZE at 512: larger is read by SDMA into an
    # unaligned buffer
  endif
else
  # U-Boot "go" address
  WOLFBOOT_LOAD_BASE?=0x40480000
  # Signed kernel at +0xC0000 in wolfboot_linux.bin
  IMX8MM_KERNEL_ADDR?=0x40540000
  # 42 MB: the kernel must end below the DTB at 0x43000000
  WOLFBOOT_RAMBOOT_MAX_SIZE?=0x2A00000
endif
CFLAGS_EXTRA+=-DIMX8MM_KERNEL_ADDR=$(IMX8MM_KERNEL_ADDR)
# Kernel run address
WOLFBOOT_LOAD_ADDRESS?=0x44000000
# DTB address
WOLFBOOT_LOAD_DTS_ADDRESS?=0x43000000
# Image read from DRAM (memcpy), RAM boot
EXT_FLASH?=1
