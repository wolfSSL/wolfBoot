# NXP S32G2 GoldBox (S32G-VNP-GLDBOX, S32G274A-RDB2) - wolfBoot as the Boot
# ROM's application image: copied into SRAM at 0x340A0000 and entered at EL3
# with only FIRC running, in place of U-Boot. The signed FIT (kernel + DTB,
# hal/s32g2.its) is read from a FAT32 partition of the SD card, or of the
# eMMC with DISK_EMMC=1 DISK_SDCARD=0.
#
# The LPDDR4 tables and PHY firmware come from the NXP BSP U-Boot sources:
#   tools/scripts/s32g2/s32g2-ddr-blob.py <nxp-u-boot> s32g2_ddr.bin
# Wrap wolfboot.bin for the Boot ROM and write it at SD byte offset 0x1000:
#   tools/scripts/s32g2/s32g2_mkimage.py wolfboot.bin s32g2_boot.bin
#   dd if=s32g2_boot.bin of=/dev/sdX bs=512 seek=8
# See docs/Targets.md.
#
# Never pass CFLAGS_EXTRA= on the command line - it replaces, not appends.
ARCH=AARCH64
TARGET=s32g2
SIGN?=ECC384
HASH?=SHA384
DEBUG?=1
DEBUG_UART?=1
SPMATH?=1
NO_XIP?=1
# The HAL sets up the GICv3 itself (hal/s32g2.c); skip the generic GICv2 init.
SKIP_GIC_INIT?=1
WOLFBOOT_SECTOR_SIZE?=0x1000
WOLFBOOT_NO_PARTITIONS=1
GZIP?=1
DISK_SDCARD?=1
DISK_FS?=fat32

# A/B slots: two files on the third partition (FAT32). The higher version
# boots. An older version is not used when the newer one fails to verify
# (anti-rollback), unless built with ALLOW_DOWNGRADE=1.
# A slot staged by an update is booted once on probation and skipped on the
# next boot unless the OS confirmed it (docs/compile.md, "Disk boot
# confirmation"). The state is the last 8 bytes of the slot's file.
DISK_BOOT_CONFIRM?=1
CFLAGS_EXTRA+=-DBOOT_PART_A=2
CFLAGS_EXTRA+=-DBOOT_PART_B=2
CFLAGS_EXTRA+=-DBOOT_FILE_A='"/fitImage_a.bin"'
CFLAGS_EXTRA+=-DBOOT_FILE_B='"/fitImage_b.bin"'

WOLFBOOT_RAMBOOT_MAX_SIZE=0x4000000
WOLFBOOT_LOAD_ADDRESS?=0xA0000000
WOLFBOOT_LOAD_DTS_ADDRESS?=0xA5000000
