# STM32H7 with a compressed update partition, executing in place. The H743
# has 2MB of flash in 128KB sectors.
ARCH?=ARM
TARGET?=stm32h7
SIGN?=ECC256
HASH?=SHA256
DEBUG?=0
DEBUG_UART?=0
VTOR?=1
NO_ASM?=0
EXT_FLASH?=0
SPI_FLASH?=0
ALLOW_DOWNGRADE?=0
NVM_FLASH_WRITEONCE?=0
WOLFBOOT_VERSION?=1
V?=0
SPMATH?=1
RAM_CODE?=0
DUALBANK_SWAP?=0

# Implies DISABLE_BACKUP: no swap, and no backup of the outgoing image.
COMPRESSED_UPDATE?=1

# LZ77 window the image was compressed with. The decoder needs twice this in
# RAM, which fits the 128KB DTCM wolfBoot runs from here. Sign with
# 'sign --compress=14' to match.
WOLFBOOT_COMPRESSED_WINDOW?=16384

# UPDATE is sized for the container alone. The split has to cover the worst
# ratio the product will ever ship; the signing tool refuses an artifact
# that does not fit, so a bad split fails at build time, not on the device.
WOLFBOOT_SECTOR_SIZE?=0x20000
WOLFBOOT_PARTITION_SIZE?=0x100000
WOLFBOOT_PARTITION_UPDATE_SIZE?=0xE0000
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0x8020000
WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0x8120000
# No swap step in this mode, so no swap partition is reserved.
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0

# required for keytools
WOLFBOOT_FIXED_PARTITIONS=1
