ARCH?=ARM
TARGET?=mcxa
SIGN?=ML_DSA
ML_DSA_LEVEL?=2
IMAGE_SIGNATURE_SIZE?=2420
HASH?=SHA256
MCUXSDK?=1
#MCUXPRESSO?=$(PWD)/../NXP/mcux-sdk
MCUXPRESSO?=$(PWD)/../NXP/mcuxpresso-sdk/mcuxsdk
MCUXPRESSO_CMSIS?=$(PWD)/../NXP/CMSIS_5/CMSIS
MCUXPRESSO_CPU?=MCXA153VLH
MCUXPRESSO_DRIVERS?=$(MCUXPRESSO)/devices/MCX/MCXA/MCXA153
MCUXPRESSO_PROJECT_TEMPLATE?=$(MCUXPRESSO)/examples/_boards/frdmmcxa153/project_template
DEBUG?=0
VTOR?=1
CORTEX_M0?=0
NO_ASM?=0
EXT_FLASH?=0
SPI_FLASH?=0
ALLOW_DOWNGRADE?=0
NVM_FLASH_WRITEONCE?=0
WOLFBOOT_VERSION?=0
V?=0
SPMATH?=1
RAM_CODE?=1
DUALBANK_SWAP?=0
PKA?=1

# ML-DSA-44, 8KB header and sector: 32KB boot, 40KB partitions, 8KB swap.
# ML-DSA-87 does not fit the 128KB flash: its 16KB header needs 16KB sectors
# and the image limit of one partition less a sector leaves no room.
IMAGE_HEADER_SIZE?=8192
WOLFBOOT_SECTOR_SIZE?=0x2000
WOLFBOOT_PARTITION_SIZE?=0xA000
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0x8000
WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0x12000
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0x1C000
